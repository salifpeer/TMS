# Copy this file to .env and fill in real values before deploying anywhere.
# The code falls back to safe defaults for local development, so you do not
# need this file to run the project on your machine.

# Key used to sign JWTs. Anyone who has it can forge tokens, so keep it out
# of git. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
TMS_SECRET_KEY=change-me

# How long a token stays valid, in minutes.
TMS_TOKEN_EXPIRE_MINUTES=30

# Where the Streamlit pages should look for the API.
TMS_API_URL=http://127.0.0.1:8000
